# Copy this file to .env.local in this directory. Never commit a real key.
# Use deterministic for credential-free manual development. Change this local
# value to gemini only for an intentional real-provider manual run. Playwright
# selects its planner mode explicitly and does not depend on this value.
HSD_PLANNER_MODE=deterministic
HSD_LEDGER_MODE=memory

# Server-side only. Obtain this from Google AI Studio; never use a NEXT_PUBLIC_ name.
# GEMINI_API_KEY=

# Server-side only. Set HSD_LEDGER_MODE=postgres and inject this value through
# Secret Manager only after applying the approved migration with a separate identity.
# DATABASE_URL=postgresql://user:password@host:5432/database
