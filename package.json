{
	"name": "bgb-labs-workspace",
	"version": "0.0.0",
	"private": true,
	"packageManager": "pnpm@10.13.1",
	"engines": {
		"node": ">=22.0.0"
	},
	"scripts": {
		"build": "pnpm --filter @bomgoodbueno/native-agent-sdk build && pnpm --filter @bomgoodbueno/hotel-shoreline build",
		"check": "biome check .",
		"format": "biome format --write .",
		"format:check": "biome format .",
		"lint": "biome lint .",
		"test": "pnpm test:unit && pnpm test:integration",
		"test:all": "pnpm test && pnpm test:coverage && pnpm test:e2e",
		"test:coverage": "pnpm --filter @bomgoodbueno/native-agent-sdk test:coverage",
		"test:e2e": "playwright test",
		"test:integration": "pnpm --filter @bomgoodbueno/native-agent-sdk test:integration",
		"test:unit": "pnpm --filter @bomgoodbueno/native-agent-sdk test:unit",
		"typecheck": "pnpm --filter @bomgoodbueno/native-agent-sdk typecheck && pnpm --filter @bomgoodbueno/hotel-shoreline typecheck"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.10",
		"@playwright/test": "1.62.1",
		"@types/node": "26.2.0",
		"@types/react": "19.2.18",
		"@types/react-dom": "19.2.5",
		"@vitest/coverage-v8": "4.1.11",
		"typescript": "7.0.2",
		"vitest": "4.1.11"
	}
}
